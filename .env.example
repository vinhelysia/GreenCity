# Copy to repository-root .env and replace placeholders.
# NEVER commit real credentials. Do not put secrets in shell history when avoidable.

# Required — use your local native PostgreSQL credentials
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

API_PORT=3001
# The browser never receives an API host. Client traffic uses same-origin /api/*,
# which apps/web/next.config.ts rewrites to this port server-side. Do not add
# NEXT_PUBLIC_API_URL back — apps/web/scripts/smoke.mjs fails the build on it.

# Deploy only: where the web server forwards /api/* to. Defaults to the local
# API above. On a split deploy (web on Vercel, API on Render) set this to the
# API's public URL, e.g. https://greencity-api.onrender.com — server-side only.
# API_PROXY_TARGET=

# Comma-separated exact HTTP(S) origins (no wildcard/path) for credentialed CORS + Origin checks
CORS_ORIGINS=http://localhost:3000

# Session cookie (HttpOnly; Secure in production)
SESSION_COOKIE_NAME=gc_session
SESSION_TTL_HOURS=336

# Login rate limit (per IP)
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_TTL_SECONDS=60

# Object storage: local | supabase (s3 is a stub). Local for dev; supabase for a
# split deploy where the API runs on ephemeral disk and images must persist.
STORAGE_DRIVER=local
# Relative paths resolve from monorepo root (same from root or apps/api cwd)
STORAGE_LOCAL_DIR=.local/storage

# Supabase Storage (only when STORAGE_DRIVER=supabase). Create a private bucket
# named below in the Supabase dashboard first. SERVICE_KEY is the service_role
# key — server-side only, treat as a secret.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=greencity-media

# Optional: overrides the db:seed demo password. Local demo works without it.
# SET THIS on any shared/deployed database — the built-in default is public.
# DEMO_PASSWORD=
# Future S3-compatible (only when STORAGE_DRIVER=s3)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=auto

# Mail: console (default) or file for Phase 0 (SMTP later)
MAIL_DRIVER=console
MAIL_FILE_DIR=.local/mail
# Future SMTP (only when MAIL_DRIVER=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# payOS payment — entirely optional. The API starts normally with all of these
# blank or absent; leaving one out only disables the payment path, it is never a
# startup error. Server-side only: never mirror these into a NEXT_PUBLIC_* key.
# payOS has no sandbox; the API host is hard-coded, not configurable.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# Public bases. PUBLIC_WEB_URL builds the payOS return link; PUBLIC_API_URL is
# only used to tell you the webhook address to register with payOS
# (<PUBLIC_API_URL>/payment-webhooks/payos). https:// required, except
# http://localhost or http://127.0.0.1 for local development.
# PUBLIC_API_URL=
# PUBLIC_WEB_URL=

# Chatwoot support chat — entirely optional, browser-visible by design. Leave
# both blank and no widget renders and nothing else changes; that is also the
# rollback (unset them in Vercel and redeploy). Set them in the Vercel web
# project, not here, for a deploy.
# The website token only identifies which inbox a message lands in. It is NOT
# the inbox HMAC secret — that one is server-side and has no NEXT_PUBLIC_ twin.
# NEXT_PUBLIC_CHATWOOT_BASE_URL=https://app.chatwoot.com
# NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# --- scripts/db-setup.ps1 (admin + app credentials; not the same as DATABASE_URL necessarily) ---
# $env:PGPASSWORD = '<postgres-admin-password>'
# $env:GREENCITY_DB_PASSWORD = '<app-role-password>'
# $env:GREENCITY_DB_USER = 'greencity'          # optional
# $env:GREENCITY_DB_NAME = 'greencity'          # optional
